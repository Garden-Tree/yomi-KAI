[DEFAULT]
DISCORD_TOKEN = YOUR_DISCORD_TOKEN
USE_GOOGLE_TTS = False
GOOGLE_API_KEY = YOUR_GOOGLE_API_KEY
;USE_GOOGLE_TTS=True の場合のみ必須。GCPのAPIキーを設定してください。
PREFIX = y.
AFK_TIME = 1800
;sec
SD_MSG = 突然の死
;y.sd を引数なしで実行したときに読み上げるメッセージ
;以下は任意項目
MAX_READ_LENGTH = 100
;読み上げる最大文字数。超えた分は「以下略」になります。0 で無制限
;VOICEVOX_LOAD_ALL_MODELS = False
;True にすると voicevox_core/models/vvms/ の *.vvm をすべて読み込みます（既定は 0.vvm のみ）
;VOICEVOX_WORKERS = 1
;同時に音声合成する数（1〜8、既定 1）。増やすと速くなりますが、メモリを多く使います
;（合成を続けたあとの目安: 1 で約280MB、2 で約530MB、4 で約890MB。Windows・0.vvm のみで計測）
;ALERT_WEBHOOK_URL = https://discord.com/api/webhooks/xxxx/yyyy
;Discord から長時間切断されたときに通知を送る Webhook の URL。空または未設定なら通知しません
;（チャンネルの設定 → 連携サービス → ウェブフック → 新しいウェブフック → ウェブフックURLをコピー）
;ALERT_AFTER = 300
;切断がこの秒数（30以上）続いたら通知します。既定は 300（5分）
;LOG_READ_TEXT = False
;True にすると、読み上げた本文をログファイル（log/）に記録します。既定 False（本文はログに残しません）
;USAGE_DIR = usage
;月ごとの使用量（サーバー・ユーザーごとの読み上げ文字数とメッセージ数。本文は保存しません）の保存先。既定 usage
;MAX_DICT_ENTRIES = 0
;サーバーごとの辞書に登録できる単語の数の上限。既定 0（無制限）。登録済みの単語の読みの変更は上限に達していてもできます
;SPEAKER_ALLOWLIST = ずんだもん, 春日部つむぎ, 四国めたん, 雨晴はう
;使える話者を `y.voice list` に表示される名前のカンマ（, 、 ，のいずれでも可）区切りで指定します。空または未設定ならすべての話者を使えます
;BLOCKED_GUILDS_FILE = settings/blocked_guilds.txt
;利用を断るサーバーの ID を1行に1つ書いたファイル（# 以降はコメント）。ファイルが無ければ何もしません
;Bot はそのサーバーから退出し、参加し直しても退出します。ファイルの変更は30秒以内に反映されます
