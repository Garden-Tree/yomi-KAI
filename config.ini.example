[DEFAULT]
DISCORD_TOKEN = YOUR_DISCORD_TOKEN
USE_GOOGLE_TTS = False
GOOGLE_API_KEY = YOUR_GOOGLE_API_KEY
;USE_GOOGLE_TTS=True の場合のみ必須。GCPのAPIキーを設定してください。
PREFIX = y.
AFK_TIME = 1800
;sec
SD_MSG = 突然の死
;y.sd を引数なしで実行したときに読み上げるメッセージ（ENABLE_SUDDEN_DEATH = False なら省略可）
;以下は任意項目
MAX_READ_LENGTH = 100
;読み上げる最大文字数。超えた分は「以下略」になります。0 で無制限
;VOICEVOX_LOAD_ALL_MODELS = False
;True にすると voicevox_core/models/vvms/ の *.vvm をすべて読み込みます（既定は 0.vvm のみ）
;VOICEVOX_WORKERS = 1
;同時に音声合成する数（1〜8、既定 1）。増やすと速くなりますが、メモリを多く使います
;（合成を続けたあとの目安: 1 で約280MB、2 で約530MB、4 で約890MB。Windows・0.vvm のみで計測）
;ALERT_WEBHOOK_URL = https://discord.com/api/webhooks/xxxx/yyyy
;Discord から長時間切断されたときに通知を送る Webhook の URL。空または未設定なら通知しません
;（チャンネルの設定 → 連携サービス → ウェブフック → 新しいウェブフック → ウェブフックURLをコピー）
;ALERT_AFTER = 300
;切断がこの秒数（30以上）続いたら通知します。既定は 300（5分）
;LOG_READ_TEXT = False
;True にすると、読み上げた本文をログファイル（log/）に記録します。既定 False（本文はログに残しません）
;ENABLE_SUDDEN_DEATH = True
;False にすると「突然の死」コマンド（y.sd・/sd）を登録せず、ヘルプにも表示しません（既定 True）
;MAX_USER_DICT_ENTRIES = 0
;個人辞書（y.mydict）の1人あたりの登録数の上限。0 で無制限（既定）
;PREMIUM_ENABLED = False
;True にすると settings/premium.json に書いたサーバーで PREMIUM_* の上限を使います（既定 False。docs/hosting.md 参照）
;PREMIUM_SYNC_URL =
;PREMIUM_SYNC_TOKEN =
;サイトで受け付けた Stripe の契約を5分ごとに取得し、settings/premium.json に反映します（PREMIUM_ENABLED = True のときだけ。両方とも指定。docs/hosting.md の「Stripe の契約の同期」参照）
;PREMIUM_SITE_URL =
;PREMIUM_LINK_SECRET =
;y.plan で「サーバー管理」の権限を持つ人に、申し込み・契約の管理のリンクを本人にだけ見える形で渡します（両方とも指定。トークン・シークレットは32文字以上）
;多くのサーバーに公開する場合の設定（辞書の上限・使える話者の制限・プレミアムプラン・ブラックリスト・使用量の記録）は docs/hosting.md を参照してください
